<% bg_color = case type.to_sym
      when :notice, :info then "notice bg-blue-100 border-blue-400 text-blue-700"
      when :success then "success bg-green-100 border-green-400 text-green-700"
      when :alert, :warning then "warning bg-yellow-100 border-yellow-400 text-yellow-700"
      when :error then "error bg-red-100 border-red-400 text-red-700"
      else "bg-gray-100 border-gray-400 text-gray-700"
      end %>
<div role="alert" data-controller="flash" class="border px-4 py-3 rounded shadow-md flex w-fit justify-between items-center <%= bg_color %>" role="alert">
  <div class="flex items-center mr-6 grow">
    <span><%= message %></span>
  </div>
  <button data-action="flash#hide">X</button>
</div>