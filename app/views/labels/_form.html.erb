<%= form_with model: label do |f| %>
    <% if label.errors.any? %>
        <div class="errors">
            <h2><%= pluralize(label.errors.count, "error") %> prohibited this label from being saved:</h2>

            <ul>
                <% label.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                <% end %>
            </ul>
        </div>
    <% end %>
    <div class="field">
        <%= f.label :name %>
        <%= f.text_field :name %>
    </div>

    <div class="actions">
        <%= f.submit %>
    </div>
<% end %>
