<h1><%= @label.name %></h1>

<ul>
    <% @label.tasks.each do |task| %>
        <li>
            <%= link_to task.title, task_path(task) %>
            <% if task.completed %>
                (Completed)
            <% end %>
        </li>
    <% end %>
</ul>

<%= button_to "Delete Label", label_path(@label), method: :delete, data: { confirm: "Are you sure?" } %>