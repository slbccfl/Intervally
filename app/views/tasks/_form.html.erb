
<%= form_with(model: task, local: true, class: "flex flex-col gap-6 max-w-lg bg-white p-6 rounded-xl shadow-sm border border-gray-500") do |form| %>

  <h2 class="text-2xl font-bold"><%=action_name.capitalize%> Task</h2>

  <%= render "application/flashes" %>

  <!-- Task Name Input (Vertical Stack) -->
  <div class="flex flex-col gap-1.5">
    <%= form.label :title, "Title", class: "text-sm font-semibold text-gray-700" %>
    <%= form.text_field :title, placeholder: "e.g., File Quarterly Taxes", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2.5 border" %>
  </div>

  <!-- Second row of the form -->
  <div class="h-1/2 justify-evenly flex">

    <!-- Due Date Input (Vertical Stack) -->
    <div class="flex flex-col gap-1.5">
      <%= form.label :due_on, "Due Date", class: "text-sm font-semibold text-gray-700" %>
      <%= form.date_field :due_on, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2.5 border" %>
    </div>

    <!-- Recurrence Input (Vertical Stack) -->
    <div class="flex flex-col gap-1.5">
      <%= form.label :cycle, "Recurrence Cycle (In Days)", class: "text-sm font-semibold text-gray-700" %>
      <%= form.number_field :cycle, min: 0, placeholder: "e.g., 30 (Blank for once)", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2.5 border" %>
    </div>

    <!-- Priority Input (Vertical Stack) -->
    <div class="flex flex-col gap-1.5">
      <%= form.label :priority, "Priority", class: "text-sm font-semibold text-gray-700" %>
      <%= form.number_field :priority, min: 1, max: 5, placeholder: "1 to 5", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2.5 border" %>
    </div>
  </div>

  <!-- Cancel and Submit Buttons -->
  <div class="flex justify-evenly">
    <%= button_tag "Cancel", type: :button, data: { action: "click->modal#hide" }, class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>

    <%= form.submit class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
  </div>

<% end %>



