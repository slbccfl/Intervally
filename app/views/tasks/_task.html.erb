<!-- A Task Card --> 
<div id="<%= dom_id task %>" class="h-12 w-60 rounded border border-gray-300 <%= bg_color_for_priority(task.priority) %>">
  <!-- First row of the card -->
  <div class="flex h-1/2">
    <!-- Done Checkbox Cell -->
    <div class="justify-center w-1/12">
      <input type="checkbox" <%= 'checked' if task.completed %> disabled class="h-4 w-4 rounded border-gray-900 text-blue-600 focus:ring-blue-500">
    </div>

    <!-- Task Title Cell -->
    <div class="text-sm font-semibold justify-content w-9/12 <%= task.completed ? 'text-gray-500 line-through font-normal' : 'text-gray-800' %>">
      <%= button_to edit_task_path(task), method: :get, data: {turbo_frame: "modal"} do %>
        <%= task.title %>
      <% end %>
    </div>


    <div class="w-2/12 flex justify-center items-center gap-2">
      <%= button_to task_path(task), method: :delete, data: { turbo_confirm: "Are you sure?" } do %>
        <i class="fa-solid fa-trash-can"></i>
      <% end %>
    </div>
  </div>

  <!-- Second row of the card -->
  <div class="text-xs text-gray-800 h-1/2 justify-evenly flex">
    <!-- Due Date Cell -->
    <div>
      <%= task.due_on&.strftime("%b %d, %Y") || "No date" %>
    </div>

    <!-- Recurrence Cycle Cell -->
    <div class="italic">
      <%= task.cycle.present? ? "(every #{task.cycle} days)" : "One-time task" %>
    </div>
  </div>
</div>

