<!-- A Task Card --> 
<div id="<%= dom_id task %>" class="h-14 w-60 rounded border border-gray-300 <%= bg_color_for_priority(task.priority) %>">
  <!-- First row of the card -->
  <div class="flex h-4/10">
    <!-- Done Checkbox Cell -->
    <div class="justify-center w-1/12">
      <%= form_with url: toggle_status_task_path(task), method: :patch, class: "inline-flex", data: { turbo: true } do %>
        <%= hidden_field_tag :completed, "false" %>
        <%= check_box_tag :completed, "true", task.completed, class: "h-4 w-4 rounded border-gray-900 text-blue-600 focus:ring-blue-500", onchange: "this.form.requestSubmit()" %>
      <% end %>
    </div>

    <!-- Task Title Cell -->
    <div class="text-sm font-semibold justify-content w-9/12 <%= task.completed ? 'text-gray-500 line-through font-normal' : 'text-gray-800' %>">
      <%= button_to edit_task_path(task), method: :get, data: {turbo_frame: "modal"} do %>
        <%= task.title %>
      <% end %>
    </div>


    <div class="w-2/12 flex justify-center items-center gap-2">
      <%= button_to task_path(task), method: :delete, data: { turbo_confirm: "Are you sure?" } do %>
        <i class="fa-solid fa-trash-can"></i>
      <% end %>
    </div>
  </div>

  <!-- Second row of the card -->
  <div class="text-xs text-gray-800 h-3/10 justify-evenly flex">
    <!-- Due Date Cell -->
    <div>
      <%= task.due_on&.strftime("%b %d, %Y") || "No date" %>
    </div>
    <!-- Due in Days -->
    <div>
      <%= task.due_on ? "(Due in #{(task.due_on - Date.today).to_i} days)" : nil %>
    </div>

  </div>
  <!-- Third row of the card -->
  <div class="text-xs text-gray-800 h-3/10 justify-evenly flex">
    <!-- Recurrence Cycle Cell -->
    <div class="italic">
      <%= task.cycle.present? ? "Due every #{task.cycle} days" : "One-time task" %>
    </div>
    <!-- Due Ratio -->
    <% due_ratio = task.cycle ? ((task.due_on - Date.today).to_f / task.cycle.to_i).round(2) : nil %>
    <div class="italic">
      <%= due_ratio ? "Due Ratio: #{number_with_precision(due_ratio, precision: 2)}" : "" %>
    </div>
  </div>
</div>

