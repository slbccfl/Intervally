<!-- Task Row --> 
<div class="grid grid-cols-[1fr_3fr_2fr_2fr_1fr] gap-x-4 gap-y-3 items-center mb-2">

  <!-- Done Checkbox Cell -->
  <div class="flex justify-center border-b border-gray-100 py-3">
    <input type="checkbox" <%= 'checked' if task.completed %> disabled class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
  </div>

  <!-- Task Title Cell -->
  <div class="text-sm font-semibold border-b border-gray-100 py-3 <%= task.completed ? 'text-gray-400 line-through font-normal' : 'text-gray-800' %>">
    <%= task.title %>
  </div>

  <!-- Due Date Cell -->
  <div class="text-sm text-gray-500 border-b border-gray-100 py-3">
    <%= task.due_on&.strftime("%b %d, %Y") || "No date" %>
  </div>

  <!-- Recurrence Cycle Cell -->
  <div class="text-sm text-gray-500 italic border-b border-gray-100 py-3">
    <%= task.cycle.present? ? "#{task.cycle} days" : "One-time task" %>
  </div>

  <!-- Actions Cell (Flexbox Container) -->
  <div class="flex justify-end gap-3 border-b border-gray-100 py-3 text-sm">
    <%= link_to 'Edit', edit_task_path(task), class: "text-blue-600 hover:text-blue-800 font-medium" %>
    <%= link_to 'Delete', task, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-800 font-medium" %>
  </div>

</div>
