<table class="w-full">
  <thead>
    <tr class="flex items-center justify-between">
      <h1 class="text-4xl font-bold">Tasks</h1>
    </tr>
  </thead>
  <tbody>
    <tr class="min-w-full my-8 font-bold border">
      <td class="w-1/20"></td>
      <td class="w-4/10">Task</td>
      <td class="w-3/10">Next Due</td>
      <td class="w-1/20">Cycle</td>
      <td class="w-2/10"></td>
    </tr>
    <tr id="tasks" class="min-w-full">
      <%= render @tasks %>
    </tr>
  </tbody>
</table>
<%= link_to "New Task", new_task_path, data: {turbo_frame: "modal"} %>