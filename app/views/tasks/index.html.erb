<div class="max-w-6xl mx-auto p-6 bg-gray-50 min-h-screen">
  <!-- Page Header Row Elements (Flexbox) -->
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
      Tasks
    </h1>
  </div>
  <!-- CSS Grid for Task List -->
  <!-- Task Table Headers -->
  <div class="grid grid-cols-[1fr_3fr_2fr_2fr_1fr] gap-x-4 gap-y-3 items-center mb-2">
    <!-- Table Grid Headers -->
    <div class="text-xs font-bold uppercase tracking-wider text-gray-800 border-b pb-2 text-center">Done</div>
    <div class="text-xs font-bold uppercase tracking-wider text-gray-800 border-b pb-2">Task Name</div>
    <div class="text-xs font-bold uppercase tracking-wider text-gray-800 border-b pb-2">Due Date</div>
    <div class="text-xs font-bold uppercase tracking-wider text-gray-800 border-b pb-2">Repeats Every</div>
    <div class="text-xs font-bold uppercase tracking-wider text-gray-800 border pb-2 text-right">Actions</div>
  </div>

  <!-- Task List -->
  <div class="divide-y divide-gray-100">
    <% @tasks.each do |task| %>
      <%= render task %>
    <% end %>
  </div>
  <%= link_to "New Task", new_task_path, data: {turbo_frame: "modal"} %>
</div>