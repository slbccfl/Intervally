<%= turbo_frame_tag "modal" do %>
  <div class="modal">
    <h1 class="text-2xl font-bold mb-4">New Task</h1>
    <%= render "form", task: @task %>
    <div>
      <%= link_to "Cancel", "#", class: "cancel-btn", data: {
        controller: "modals",
        action: "click->modal#close"
      } %>
    </div>
  </div>
<% end %>

