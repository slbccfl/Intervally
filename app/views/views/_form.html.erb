<%= form_with(model: view, local: true, class: "flex flex-col gap-6 max-w-lg bg-white p-6 rounded-xl shadow-sm border border-gray-500") do |form| %>
  <%= form.hidden_field :view_id %>

  <% if local_assigns.key?(:active_view_id) %>
    <%= hidden_field_tag :active_view_id, active_view_id %>
  <% end %>

  <h2 class="text-2xl font-bold"><%= action_name.capitalize %> View</h2>

  <%= render "application/flashes" %>

  <!-- View Name Input (Vertical Stack) -->
  <div class="flex flex-col gap-1.5">
    <%= form.label :name, "Name", class: "text-sm font-semibold text-gray-700" %>
    <%= form.text_field :name, placeholder: "e.g., Work", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2.5 border" %>
  </div>

  <!-- Cancel and Submit Buttons -->
  <div class="flex justify-evenly">
    <%= button_tag "Cancel", type: :button, data: { action: "click->modal#hide" }, class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>

    <%= form.submit class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
  </div>

<% end %>