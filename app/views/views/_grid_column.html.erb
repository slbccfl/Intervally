<div id="view-column-<%= view.id %>" data-sortable-id="<%= view.id %>" data-controller="board-drop" data-board-drop-view-id-value="<%= view.id %>" draggable="true" data-action="dragstart->board-drop#dragStart" class="flex flex-col gap-2">
  <%= render "views/view_header", view: view %>
  <%= render "tasks/task_list", tasks: view.tasks.sorted_by_urgency, dom_id: "task-list-#{view.id}" %>
  <%= link_to "New Task", new_task_path(view_id: view.id), data: { turbo_frame: "modal" }, class: "text-sm text-blue-600 hover:underline" %>
</div>