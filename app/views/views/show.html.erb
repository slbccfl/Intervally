<div class="max-w-6xl mx-auto p-6 bg-gray-50 min-h-screen flex gap-6">
  <!-- Sidebar -->
  <div class="w-56 shrink-0">
    <%= render "views/sidebar", views: @views, active_view: @view %>
  </div>

  <!-- Main content -->
  <div class="flex-1">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
        <%= @view.name %>
      </h1>
    </div>
    <div class="flex flex-col gap-4">
      <%= render "tasks/task_list", tasks: @tasks %>
    </div>
    <%= link_to "New Task", new_task_path, data: { turbo_frame: "modal" } %>
  </div>
</div>